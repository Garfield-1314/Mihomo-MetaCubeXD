@@ -0,0 +1,455 @@
+import type { KernelState, MihomoSupervisor } from './types'
+import { mkdtemp, readdir, readFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { parse } from 'yaml'
+import { createProfileStore } from './profiles'
+import {
+  createRouterController,
+  normalizeRouterTunStack,
+  parseRouterSource,
+  renderRouterConfig,
+  ROUTER_AUTO_GROUP,
+  ROUTER_MAIN_GROUP,
+} from './router'
+
+const SUB_A = `
+proxies:
+  - name: A-HK
+    type: ss
+    server: a.example.com
+    port: 8388
+    cipher: aes-128-gcm
+    password: secret
+  - name: A-US
+    type: ss
+    server: a2.example.com
+    port: 8388
+    cipher: aes-128-gcm
+    password: secret
+`
+
+const SUB_B = `
+proxies:
+  - name: B-JP
+    type: ss
+    server: b.example.com
+    port: 8388
+    cipher: aes-128-gcm
+    password: secret
+`
+
+const tempDirs: string[] = []
+
+async function tempHome(): Promise<string> {
+  const dir = await mkdtemp(join(tmpdir(), 'mcxd-router-'))
+  tempDirs.push(dir)
+  return dir
+}
+
+afterEach(async () => {
+  await Promise.all(
+    tempDirs.splice(0).map((dir) => rm(dir, { recursive: true, force: true })),
+  )
+})
+
+function fakeSupervisor(valid = true): {
+  supervisor: MihomoSupervisor
+  validate: ReturnType<typeof vi.fn>
+  restart: ReturnType<typeof vi.fn>
+  start: ReturnType<typeof vi.fn>
+} {
+  const state: KernelState = {
+    status: 'running',
+    externalController: '127.0.0.1:9090',
+    secret: 'test-secret',
+    startedAt: 1,
+  }
+  const validate = vi.fn(async () => ({
+    valid,
+    message: valid ? '' : 'bad config',
+  }))
+  const restart = vi.fn(async () => state)
+  const start = vi.fn(async () => state)
+  const supervisor = {
+    getState: () => state,
+    start,
+    stop: async () => state,
+    restart,
+    setBinaryPath: () => {},
+    validate,
+    on: () => {},
+    off: () => {},
+    dispose: async () => {},
+  } as unknown as MihomoSupervisor
+  return { supervisor, validate, restart, start }
+}
+
+async function storeFor(home: string, fetchImpl?: typeof fetch) {
+  return createProfileStore({
+    dir: join(home, 'profiles'),
+    activeConfigPath: join(home, 'active.yaml'),
+    fetch: fetchImpl,
+  })
